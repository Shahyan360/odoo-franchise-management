<odoo>
<menuitem id="menu_root" name="Franchise Operations" groups="franchise_operations.group_user"/>
<record id="view_contracts_list" model="ir.ui.view"><field name="name">franchise.contract.list</field><field name="model">franchise.contract</field><field name="arch" type="xml"><list><field name="name"/><field name="code"/><field name="company_id"/><field name="partner_id"/><field name="region"/><field name="administrator_id"/><field name="start_date"/><field name="end_date"/><field name="active"/><field name="state"/><field name="currency_id"/><field name="note"/></list></field></record>
<record id="view_contracts_form" model="ir.ui.view"><field name="name">franchise.contract.form</field><field name="model">franchise.contract</field><field name="arch" type="xml"><form><header><button type="object" name="action_bill_current" string="Generate Current Month Invoice"/></header><sheet><group><field name="name"/><field name="code"/><field name="company_id"/><field name="partner_id"/><field name="region"/><field name="administrator_id"/><field name="start_date"/><field name="end_date"/><field name="active"/><field name="state"/><field name="currency_id"/><field name="note"/></group><field name="fee_ids"><list editable="bottom"><field name="name"/><field name="product_id"/><field name="amount"/><field name="discount_percent"/></list></field></sheet></form></field></record>
<record id="action_contracts" model="ir.actions.act_window"><field name="name">Franchise Contracts</field><field name="res_model">franchise.contract</field><field name="view_mode">list,form</field></record><menuitem id="menu_contracts" name="Franchise Contracts" parent="menu_root" action="action_contracts"/>
<record id="view_billing_list" model="ir.ui.view"><field name="name">franchise.billing.list</field><field name="model">franchise.billing</field><field name="arch" type="xml"><list><field name="contract_id"/><field name="company_id"/><field name="period"/><field name="invoice_id"/><field name="total"/><field name="residual"/><field name="currency_id"/><field name="payment_state"/></list></field></record>
<record id="view_billing_form" model="ir.ui.view"><field name="name">franchise.billing.form</field><field name="model">franchise.billing</field><field name="arch" type="xml"><form><header></header><sheet><group><field name="contract_id"/><field name="company_id"/><field name="period"/><field name="invoice_id"/><field name="total"/><field name="residual"/><field name="currency_id"/><field name="payment_state"/></group></sheet></form></field></record>
<record id="action_billing" model="ir.actions.act_window"><field name="name">Monthly Billing</field><field name="res_model">franchise.billing</field><field name="view_mode">list,form</field></record><menuitem id="menu_billing" name="Monthly Billing" parent="menu_root" action="action_billing"/>
<record id="view_dashboard_list" model="ir.ui.view"><field name="name">franchise.dashboard.list</field><field name="model">franchise.dashboard</field><field name="arch" type="xml"><list><field name="name"/><field name="company_id"/><field name="month"/><field name="campus_count"/><field name="active_count"/><field name="billed"/><field name="collected"/><field name="outstanding"/><field name="overdue"/><field name="currency_id"/></list></field></record>
<record id="view_dashboard_form" model="ir.ui.view"><field name="name">franchise.dashboard.form</field><field name="model">franchise.dashboard</field><field name="arch" type="xml"><form><header></header><sheet><group><field name="name"/><field name="company_id"/><field name="month"/><field name="campus_count"/><field name="active_count"/><field name="billed"/><field name="collected"/><field name="outstanding"/><field name="overdue"/><field name="currency_id"/></group><field name="regions"/></sheet></form></field></record>
<record id="action_dashboard" model="ir.actions.act_window"><field name="name">Headquarters Dashboard</field><field name="res_model">franchise.dashboard</field><field name="view_mode">list,form</field></record><menuitem id="menu_dashboard" name="Headquarters Dashboard" parent="menu_root" action="action_dashboard"/>
<record id="view_bank_list" model="ir.ui.view"><field name="name">franchise.bank.adapter.list</field><field name="model">franchise.bank.adapter</field><field name="arch" type="xml"><list><field name="code"/><field name="company_id"/><field name="secret_env"/><field name="journal_id"/><field name="service_user_id"/><field name="active"/></list></field></record>
<record id="view_bank_form" model="ir.ui.view"><field name="name">franchise.bank.adapter.form</field><field name="model">franchise.bank.adapter</field><field name="arch" type="xml"><form><header></header><sheet><group><field name="code"/><field name="company_id"/><field name="secret_env"/><field name="journal_id"/><field name="service_user_id"/><field name="active"/></group></sheet></form></field></record>
<record id="action_bank" model="ir.actions.act_window"><field name="name">Bank Adapter</field><field name="res_model">franchise.bank.adapter</field><field name="view_mode">list,form</field></record><menuitem id="menu_bank" name="Bank Adapter" parent="menu_root" action="action_bank"/>
<record id="view_receipts_list" model="ir.ui.view"><field name="name">franchise.bank.receipt.list</field><field name="model">franchise.bank.receipt</field><field name="arch" type="xml"><list><field name="adapter_id"/><field name="company_id"/><field name="txid"/><field name="invoice_id"/><field name="amount"/><field name="currency_id"/><field name="payment_date"/><field name="provider_status"/><field name="state"/><field name="payment_ids"/><field name="error"/></list></field></record>
<record id="view_receipts_form" model="ir.ui.view"><field name="name">franchise.bank.receipt.form</field><field name="model">franchise.bank.receipt</field><field name="arch" type="xml"><form><header><button type="object" name="action_apply" string="Register and Reconcile"/></header><sheet><group><field name="adapter_id"/><field name="company_id"/><field name="txid"/><field name="invoice_id"/><field name="amount"/><field name="currency_id"/><field name="payment_date"/><field name="provider_status"/><field name="state"/><field name="payment_ids"/><field name="error"/></group></sheet></form></field></record>
<record id="action_receipts" model="ir.actions.act_window"><field name="name">Bank Receipts</field><field name="res_model">franchise.bank.receipt</field><field name="view_mode">list,form</field></record><menuitem id="menu_receipts" name="Bank Receipts" parent="menu_root" action="action_receipts"/>
</odoo>
